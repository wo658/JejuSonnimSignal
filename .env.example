# 손님 신호등 설정 파일. 이 파일을 .env 로 복사해 값을 넣으세요. (setup.bat 이 자동 복사)

# Claude API 키 (AI 설명용). 비워 두면 AI 없이 틀 문장으로 결과지를 만듭니다.
ANTHROPIC_API_KEY=

# 제주데이터허브 프로젝트키 (선택). 데이터 스냅샷을 새로 받을 때만 필요합니다. 실행에는 필요 없습니다.
JEJU_PROJECT_KEY=

# 아래는 바꾸지 않아도 됩니다.
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=low
# LLM=on            (off 로 하면 AI 설명을 끕니다)
# AUTO_DELETE=on    (off 로 하면 켤 때 지난 자료를 지우지 않습니다)
